# Normalize by default repository in LF
* text=auto eol=lf

# Text files — use LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.prisma text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.npmrc text eol=lf

# Binary files — leave as is
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary