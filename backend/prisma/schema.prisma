generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String  @id @default(cuid(2))
  email        String  @unique
  passwordHash String
  name         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model Artist {
  id          String       @id @default(cuid(2))
  slug        String       @unique
  name        String
  bio         String?
  avatarUrl   String?
  email       String?      @unique
  socialLinks SocialLink[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  artworks Artwork[]
  series   Series[]

  @@map("artists")
}

model Series {
  id          String  @id @default(cuid(2))
  slug        String
  title       String
  description String?
  isPublished Boolean @default(true)
  sortOrder   Int     @default(0)

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  artworks Artwork[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, slug])
  @@index([artistId, isPublished])
  @@map("series")
}

model Artwork {
  id          String   @id @default(cuid(2))
  slug        String
  title       String
  description String?
  medium      String?
  year        Int?
  widthCm     Decimal? @db.Decimal(6, 2)
  heightCm    Decimal? @db.Decimal(6, 2)
  price       Decimal? @db.Decimal(10, 2)
  currency    String   @default("USD")
  isSold      Boolean  @default(false)
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  seriesId String?
  series   Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  images ArtworkImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([artistId, slug])
  @@index([artistId, isPublished])
  @@index([seriesId])
  @@map("artworks")
}

model ArtworkImage {
  id        String  @id @default(cuid(2))
  url       String
  publicId  String
  alt       String?
  width     Int?
  height    Int?
  sortOrder Int     @default(0)

  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([artworkId, sortOrder])
  @@map("artwork_images")
}

model SocialLink {
  id        String @id @default(cuid(2))
  platform  String
  url       String
  sortOrder Int    @default(0)

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, platform])
  @@map("social_links")
}
